// ---------------------------------------------------------------------------
// Referral program ("Club de Familias iQ")
// ---------------------------------------------------------------------------

enum ReferralCouponKind {
  // The code the referrer shares: a percentage off for a new customer.
  FRIEND_DISCOUNT
  // The referrer's personal code to spend the credit; only works with the owner's DNI.
  REFERRER_CREDIT
}

enum ReferralAccountStatus {
  // Signed in but has not created the codes yet.
  INVITED
  ACTIVE
  BLOCKED
}

enum ReferralCreditStatus {
  PENDING
  AVAILABLE
  REJECTED
  VOIDED
}

model ReferralSettings {
  id                       Int      @id @default(1)
  enabled                  Boolean  @default(false)
  friendDiscountPercentage Decimal  @default(15) @map("friend_discount_percentage") @db.Decimal(5, 2)
  creditAmountArs          Int      @default(5000) @map("credit_amount_ars")
  creditValidityDays       Int      @default(90) @map("credit_validity_days")
  // Days after the friend's payment is confirmed (Mercado Pago paid or transfer proof uploaded)
  // before the credit becomes available. 0 = right away.
  creditHoldDays           Int      @default(0) @map("credit_hold_days")
  // true: credits wait for an admin approval instead of turning available after the hold days.
  requireManualApproval    Boolean  @default(false) @map("require_manual_approval")
  // Link to /referidos in the store header (only while the program is enabled).
  showInHeader             Boolean  @default(false) @map("show_in_header")
  headerLabel              String   @default("Referidos") @map("header_label")
  shareMessage             String   @default("") @map("share_message")
  shareImageUrl            String?  @map("share_image_url")
  termsText                String   @default("") @map("terms_text")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("referral_settings")
}

model ReferralAccount {
  id              String                @id @default(uuid()) @db.Uuid
  // Digits only.
  taxId           String                @unique @map("tax_id")
  firstName       String?               @map("first_name")
  email           String?
  phone           String?
  status          ReferralAccountStatus @default(INVITED)
  invitedBy       String?               @map("invited_by")
  activatedAt     DateTime?             @map("activated_at")
  termsAcceptedAt DateTime?             @map("terms_accepted_at")
  lastLoginAt     DateTime?             @map("last_login_at")
  // Bumped to sign the account out of every browser.
  sessionVersion  Int                   @default(1) @map("session_version")
  notes           String?
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  coupons         Coupon[]
  credits         ReferralCredit[]
  loginTokens     ReferralLoginToken[]

  @@index([status], map: "referral_accounts_status_idx")
  @@map("referral_accounts")
}

model ReferralLoginToken {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @map("account_id") @db.Uuid
  tokenHash String          @unique @map("token_hash")
  email     String
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")
  createdAt DateTime        @default(now()) @map("created_at")
  account   ReferralAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt], map: "referral_login_tokens_account_idx")
  @@map("referral_login_tokens")
}

// One per order placed with a friend code. It turns into credit for the referrer once the order is
// confirmed and the hold period passes.
model ReferralCredit {
  id              String               @id @default(uuid()) @db.Uuid
  accountId       String               @map("account_id") @db.Uuid
  referredOrderId String               @unique @map("referred_order_id") @db.Uuid
  referredTaxId   String               @map("referred_tax_id")
  amountArs       Int                  @map("amount_ars")
  status          ReferralCreditStatus @default(PENDING)
  confirmedAt     DateTime?            @map("confirmed_at")
  holdUntil       DateTime?            @map("hold_until")
  availableAt     DateTime?            @map("available_at")
  expiresAt       DateTime?            @map("expires_at")
  reviewedBy      String?              @map("reviewed_by")
  reviewNote      String?              @map("review_note")
  notifiedAt      DateTime?            @map("notified_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  account         ReferralAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  referredOrder   Order                @relation(fields: [referredOrderId], references: [id], onDelete: Cascade)
  uses            ReferralCreditUse[]

  @@index([accountId, status], map: "referral_credits_account_status_idx")
  @@index([referredTaxId], map: "referral_credits_referred_tax_idx")
  @@index([status, holdUntil], map: "referral_credits_status_hold_idx")
  @@map("referral_credits")
}

// Part of a credit spent on an order. It stops counting when that order is cancelled, expires or
// stays unpaid past the reservation window.
model ReferralCreditUse {
  id        String         @id @default(uuid()) @db.Uuid
  creditId  String         @map("credit_id") @db.Uuid
  orderId   String         @map("order_id") @db.Uuid
  amountArs Int            @map("amount_ars")
  createdAt DateTime       @default(now()) @map("created_at")
  credit    ReferralCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([creditId, orderId], map: "referral_credit_uses_credit_order_key")
  @@index([orderId], map: "referral_credit_uses_order_idx")
  @@map("referral_credit_uses")
}

// Fixed-window counters for public endpoints (survive restarts, unlike in-memory maps).
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt], map: "rate_limit_buckets_expires_idx")
  @@map("rate_limit_buckets")
}

// ---------- Logística (Andreani, Correo Argentino y reparto propio) ----------

enum ShippingCarrier {
  OWN
  ANDREANI
  CORREO_AR
}

enum ShippingDeliveryType {
  HOME
  BRANCH
}

enum ShippingPriceSource {
  // Cotizado en el momento con la API del transportista.
  LIVE
  // Última cotización guardada (la API no respondió o la cotización sigue vigente).
  CACHED
  // Sin ninguna cotización: precio de la tabla de envíos por provincia.
  FALLBACK
  // Zona de reparto propio.
  OWN_ZONE
  // Integración apagada: precio de la tabla por provincia, como antes.
  LEGACY
  // Precio de envío fijo cargado en el cliente mayorista.
  CUSTOMER
}

enum ShipmentStatus {
  // Esperando que se confirme el pago (MP acreditado, comprobante aprobado o pedido aprobado).
  WAITING_PAYMENT
  // Listo para generar la etiqueta.
  PENDING
  PROCESSING
  CREATED
  // Falló y se reintenta solo.
  ERROR
  // No se reintenta solo (dato faltante o respuesta ambigua): se resuelve desde el admin.
  NEEDS_REVIEW
  CANCELLED
}

enum PaymentProofReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Config de logística (una sola fila).
model ShippingSettings {
  id                      Int      @id @default(1)
  // Apagado = el envío se cobra como antes (tabla por provincia) y no se generan etiquetas.
  enabled                 Boolean  @default(false)
  andreaniEnabled         Boolean  @default(false) @map("andreani_enabled")
  correoEnabled           Boolean  @default(false) @map("correo_enabled")
  ownEnabled              Boolean  @default(true) @map("own_enabled")
  branchPickupEnabled     Boolean  @default(true) @map("branch_pickup_enabled")
  // Hora de corte (hora Argentina): lo confirmado antes sale ese día hábil.
  cutoffHour              Int      @default(13) @map("cutoff_hour")
  cutoffMinute            Int      @default(0) @map("cutoff_minute")
  // Días hábiles extra de preparación después del día de despacho base.
  preparationBusinessDays Int      @default(0) @map("preparation_business_days")
  // Paquete por defecto de una unidad de producto sin medidas cargadas.
  defaultUnitWeightGrams  Int      @default(400) @map("default_unit_weight_grams")
  defaultUnitLengthCm     Int      @default(20) @map("default_unit_length_cm")
  defaultUnitWidthCm      Int      @default(15) @map("default_unit_width_cm")
  defaultUnitHeightCm     Int      @default(10) @map("default_unit_height_cm")
  // Cuánto vale una cotización guardada antes de volver a pedirla.
  quoteCacheHours         Int      @default(24) @map("quote_cache_hours")
  // Se suma a la tarifa del transportista: llevar los paquetes hasta Andreani / Correo.
  // De dónde sale el precio al cliente de Andreani / Correo: "TABLE" = la tabla por provincia de siempre;
  // "LIVE" = la tarifa real del transportista + recargo.
  carrierPricing          String   @default("TABLE") @map("carrier_pricing")
  andreaniSurchargeArs    Int      @default(2500) @map("andreani_surcharge_ars")
  // Descuento del contrato que la API de Andreani no aplica (ej. 25% sobre el tarifario). 0 = ninguno.
  andreaniDiscountPct     Int      @default(0) @map("andreani_discount_pct")
  // Transferencias: apagado = la etiqueta sale cuando suben el comprobante; prendido = cuando se aprueba en Comprobantes.
  requireProofApproval    Boolean  @default(false) @map("require_proof_approval")
  // Días hábiles de viaje de Andreani/Correo (la API no los da): AMBA, resto de Buenos Aires, resto del país.
  transitDaysAmbaMin      Int      @default(2) @map("transit_days_amba_min")
  transitDaysAmbaMax      Int      @default(3) @map("transit_days_amba_max")
  transitDaysBsasMin      Int      @default(2) @map("transit_days_bsas_min")
  transitDaysBsasMax      Int      @default(4) @map("transit_days_bsas_max")
  transitDaysRestMin      Int      @default(3) @map("transit_days_rest_min")
  transitDaysRestMax      Int      @default(6) @map("transit_days_rest_max")
  // Franja horaria del reparto propio ("entre las 14 y las 17 h"). Vacío = sin franja.
  ownDeliveryWindow       String   @default("entre las 14 y las 17 h") @map("own_delivery_window")
  // Copia oculta del mail de seguimiento: mails separados por coma.
  shippingEmailBcc        String   @default("") @map("shipping_email_bcc")
  correoSurchargeArs      Int      @default(2500) @map("correo_surcharge_ars")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("shipping_settings")
}

// Zonas de reparto propio (CABA, GBA norte, ...). Cada CP propio apunta a una.
model OwnDeliveryZone {
  id                String       @id @default(uuid()) @db.Uuid
  name              String       @unique
  priceArs          Int          @map("price_ars")
  // Vacío = el mismo precio para mayoristas.
  wholesalePriceArs Int?         @map("wholesale_price_ars")
  deliveryDaysMin   Int          @default(1) @map("delivery_days_min")
  deliveryDaysMax   Int          @default(2) @map("delivery_days_max")
  active            Boolean      @default(true)
  sortOrder         Int          @default(0) @map("sort_order")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  postalCodes       PostalCode[]

  @@map("own_delivery_zones")
}

// Tabla de códigos postales (viene de codigos_postales_db de la app). Un CP puede tener varias localidades.
model PostalCode {
  id         String           @id @default(uuid()) @db.Uuid
  postalCode String           @map("postal_code")
  province   String
  locality   String
  // Con zona = reparto propio.
  ownZoneId  String?          @map("own_zone_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  ownZone    OwnDeliveryZone? @relation(fields: [ownZoneId], references: [id], onDelete: SetNull)

  @@unique([postalCode, locality], map: "postal_codes_cp_locality_key")
  @@index([postalCode], map: "postal_codes_cp_idx")
  @@index([ownZoneId], map: "postal_codes_zone_idx")
  @@map("postal_codes")
}

// Días sin despacho además de sábados, domingos y feriados nacionales (que se calculan solos):
// puentes, cambios por decreto y días propios.
model ShippingHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("shipping_holidays")
}

// Depósitos de origen. El que es por defecto es el remitente de las etiquetas.
model Warehouse {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  contactName String   @map("contact_name")
  phone       String
  email       String
  taxId       String?  @map("tax_id")
  street      String
  number      String
  floor       String?
  locality    String
  province    String
  postalCode  String   @map("postal_code")
  isDefault   Boolean  @default(false) @map("is_default")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("warehouses")
}

// Cotizaciones guardadas: se usan mientras están vigentes y como respaldo si la API no responde.
model ShippingQuoteCache {
  id              String               @id @default(uuid()) @db.Uuid
  // transportista|tipo|CP|peso redondeado|volumen redondeado
  cacheKey        String               @unique @map("cache_key")
  carrier         ShippingCarrier
  deliveryType    ShippingDeliveryType @map("delivery_type")
  postalCode      String               @map("postal_code")
  priceArs        Int                  @map("price_ars")
  deliveryDaysMin Int?                 @map("delivery_days_min")
  deliveryDaysMax Int?                 @map("delivery_days_max")
  fetchedAt       DateTime             @map("fetched_at")

  @@index([carrier, postalCode], map: "shipping_quote_cache_carrier_cp_idx")
  @@map("shipping_quote_cache")
}

// Sucursales guardadas por transportista y CP.
model ShippingBranchCache {
  id        String          @id @default(uuid()) @db.Uuid
  cacheKey  String          @unique @map("cache_key")
  carrier   ShippingCarrier
  branches  Json
  fetchedAt DateTime        @map("fetched_at")

  @@map("shipping_branch_cache")
}

// Un envío por pedido: la etiqueta y su seguimiento. orderId único = nunca dos etiquetas para el mismo pedido.
model Shipment {
  id                 String               @id @default(uuid()) @db.Uuid
  orderId            String               @unique @map("order_id") @db.Uuid
  carrier            ShippingCarrier
  deliveryType       ShippingDeliveryType @map("delivery_type")
  status             ShipmentStatus       @default(WAITING_PAYMENT)
  trackingNumber     String?              @map("tracking_number")
  carrierShipmentId  String?              @map("carrier_shipment_id")
  labelStoragePath   String?              @map("label_storage_path")
  dispatchDate       DateTime?            @map("dispatch_date") @db.Date
  attempts           Int                  @default(0)
  nextAttemptAt      DateTime?            @map("next_attempt_at")
  lockedUntil        DateTime?            @map("locked_until")
  lastError          String?              @map("last_error")
  // Último pedido y respuesta del transportista (sin credenciales), para revisar.
  lastRequest        Json?                @map("last_request")
  lastResponse       Json?                @map("last_response")
  createdManually    Boolean              @default(false) @map("created_manually")
  customerNotifiedAt DateTime?            @map("customer_notified_at")
  labelCreatedAt     DateTime?            @map("label_created_at")
  cancelledAt        DateTime?            @map("cancelled_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  order              Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events             ShipmentEvent[]

  @@index([status, nextAttemptAt], map: "shipments_status_next_idx")
  @@map("shipments")
}

model ShipmentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  kind       String
  message    String
  actor      String?
  createdAt  DateTime @default(now()) @map("created_at")
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt], map: "shipment_events_shipment_idx")
  @@map("shipment_events")
}
