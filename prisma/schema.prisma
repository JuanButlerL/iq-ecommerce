generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
}

enum ProductColorTheme {
  CACAO
  BANANA
  PEANUT
}

enum ShippingMode {
  FLAT
  PROVINCE
}

enum SalesChannel {
  RETAIL
  WHOLESALE
}

enum TaxCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
}

enum PaymentMethod {
  BANK_TRANSFER
  MERCADO_PAGO
  ECHEQ
  DEFERRED
}

enum PaymentProvider {
  MANUAL_TRANSFER
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  PROOF_UPLOADED
  PAID
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PROOF_UPLOADED
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum SyncStatus {
  PENDING
  SUCCESS
  ERROR
}

enum SyncProvider {
  MOCK
  GOOGLE_SHEETS
  APPS_SCRIPT
}

enum SyncJobStatus {
  PENDING
  PROCESSING
  SUCCESS
  ERROR
}

enum SyncLogStatus {
  SUCCESS
  ERROR
}

enum OrderSource {
  WEB
}

enum PaymentWebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum EmailAutomationTrigger {
  WELCOME_LEAD
  CART_ABANDONED
  ORDER_CREATED
  POST_PURCHASE
}

enum EmailSendStatus {
  SENT
  SKIPPED
  ERROR
}

enum NewsletterSubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum NewsletterConsentSource {
  CHECKOUT
  WELCOME_POPUP
  NEWSLETTER_PAGE
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  SENT
  NEEDS_REVIEW
}

enum NewsletterDeliveryStatus {
  PENDING
  RESERVED
  SENT
  SKIPPED
  ERROR
}

enum CouponUsageType {
  UNLIMITED
  SINGLE_USE
  SINGLE_USE_PER_CUSTOMER
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_PAY_Y
}

enum ProductDiscountType {
  PERCENTAGE
  BUY_X_PAY_Y
}

enum MarketingSourceCategory {
  DIRECT
  ORGANIC
  META
  GOOGLE
  TIKTOK
  EMAIL
  WHATSAPP
  REFERRAL
  OTHER
}

enum MarketingSourcePlatform {
  DIRECT
  INSTAGRAM
  FACEBOOK
  THREADS
  GOOGLE
  YOUTUBE
  TIKTOK
  WHATSAPP
  EMAIL
  REFERRAL
  OTHER
}

enum MarketingEventType {
  SESSION_STARTED
  POPUP_CAPTURED
  CART_CAPTURED
  ORDER_CREATED
  ORDER_CONFIRMED
}

model AdminUser {
  id              String    @id @default(uuid()) @db.Uuid
  supabaseUserId  String?   @unique @map("supabase_user_id") @db.Uuid
  email           String    @unique
  fullName        String    @map("full_name")
  passwordHash    String?   @map("password_hash")
  role            AdminRole @default(OPERATIONS)
  allowedSections String[]  @default([]) @map("allowed_sections")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Product {
  id                                    String                      @id @default(uuid()) @db.Uuid
  name                                  String
  slug                                  String                      @unique
  shortDescription                      String                      @map("short_description")
  longDescription                       String                      @map("long_description")
  priceArs                              Int                         @map("price_ars")
  discountType                          ProductDiscountType         @default(PERCENTAGE) @map("discount_type")
  discountPercentage                    Int?                        @map("discount_percentage")
  // Buy X pay Y promo (e.g. 3x2): every X units of this product the customer pays Y.
  discountBuyQuantity                   Int?                        @map("discount_buy_quantity")
  discountPayQuantity                   Int?                        @map("discount_pay_quantity")
  // Whether the free units of the promo still count toward the free shipping threshold.
  discountFreeUnitsCountForFreeShipping Boolean                     @default(true) @map("discount_free_units_count_for_free_shipping")
  discountStartsAt                      DateTime?                   @map("discount_starts_at")
  discountEndsAt                        DateTime?                   @map("discount_ends_at")
  homeVarietyLabel                      String?                     @map("home_variety_label")
  colorTheme                            ProductColorTheme           @map("color_theme")
  visualAccentHex                       String?                     @map("visual_accent_hex")
  visualSurfaceHex                      String?                     @map("visual_surface_hex")
  visualTextHex                         String?                     @map("visual_text_hex")
  active                                Boolean                     @default(true)
  visible                               Boolean                     @default(true)
  manualSoldOut                         Boolean                     @default(false) @map("manual_sold_out")
  // Paquete con el que sale una unidad (para cotizar con Andreani y Correo). Vacío = valores por defecto de Envíos.
  weightGrams                           Int?                        @map("weight_grams")
  lengthCm                              Int?                        @map("length_cm")
  widthCm                               Int?                        @map("width_cm")
  heightCm                              Int?                        @map("height_cm")
  featured                              Boolean                     @default(false)
  sortOrder                             Int                         @default(0) @map("sort_order")
  createdAt                             DateTime                    @default(now()) @map("created_at")
  updatedAt                             DateTime                    @updatedAt @map("updated_at")
  homeFeaturedSlots                     HomeFeaturedProductSlot[]
  images                                ProductImage[]
  orderItems                            OrderItem[]
  wholesaleProducts                     WholesaleProduct[]
  wholesaleComponents                   WholesaleProductComponent[]

  @@index([active, visible, featured], map: "products_visibility_idx")
  @@index([sortOrder], map: "products_sort_idx")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  filePath  String   @map("file_path")
  publicUrl String   @map("public_url")
  altText   String   @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder], map: "product_images_sort_idx")
  @@map("product_images")
}

model ShippingRule {
  id                   String                 @id @default(uuid()) @db.Uuid
  name                 String
  description          String?
  mode                 ShippingMode
  flatPrice            Int?                   @map("flat_price")
  discountThresholdArs Int?                   @map("discount_threshold_ars")
  discountPercentage   Int?                   @map("discount_percentage")
  active               Boolean                @default(true)
  isDefault            Boolean                @default(false) @map("is_default")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  provinces            ShippingRuleProvince[]
  storeSettings        StoreSettings[]
  channel              SalesChannel           @default(RETAIL)

  @@map("shipping_rules")
}

model ShippingRuleProvince {
  id             String       @id @default(uuid()) @db.Uuid
  shippingRuleId String       @map("shipping_rule_id") @db.Uuid
  provinceCode   String       @map("province_code")
  provinceName   String       @map("province_name")
  shippingPrice  Int          @map("shipping_price")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  shippingRule   ShippingRule @relation(fields: [shippingRuleId], references: [id], onDelete: Cascade)

  @@unique([shippingRuleId, provinceCode], map: "shipping_rule_province_code_key")
  @@index([provinceCode], map: "shipping_rule_province_idx")
  @@map("shipping_rule_provinces")
}

model StoreSettings {
  id                             String        @id @default("default")
  storeName                      String        @map("store_name")
  storeCurrency                  String        @default("ARS") @map("store_currency")
  whatsappNumber                 String        @map("whatsapp_number")
  instagramUrl                   String?       @map("instagram_url")
  contactEmail                   String        @map("contact_email")
  bankAlias                      String        @map("bank_alias")
  bankCbu                        String        @map("bank_cbu")
  bankName                       String        @map("bank_name")
  bankHolder                     String        @map("bank_holder")
  bankTaxId                      String        @map("bank_tax_id")
  minimumOrderAmount             Int           @map("minimum_order_amount")
  freeShippingThreshold          Int           @map("free_shipping_threshold")
  flatShippingPrice              Int           @default(0) @map("flat_shipping_price")
  shippingMode                   ShippingMode  @default(FLAT) @map("shipping_mode")
  activeShippingRuleId           String?       @map("active_shipping_rule_id") @db.Uuid
  checkoutMessage                String?       @map("checkout_message")
  transferInstructions           String?       @map("transfer_instructions")
  enableBankTransfer             Boolean       @default(true) @map("enable_bank_transfer")
  enableMercadoPago              Boolean       @default(true) @map("enable_mercado_pago")
  enableBankTransferDiscount     Boolean       @default(false) @map("enable_bank_transfer_discount")
  bankTransferDiscountPercentage Decimal       @default(0) @map("bank_transfer_discount_percentage") @db.Decimal(5, 2)
  orderReservationHours          Int?          @map("order_reservation_hours")
  institutionalBanner            String?       @map("institutional_banner")
  announcementBarEnabled         Boolean       @default(false) @map("announcement_bar_enabled")
  announcementBarText            String?       @map("announcement_bar_text")
  faqSectionEnabled              Boolean       @default(false) @map("faq_section_enabled")
  faqEyebrow                     String?       @map("faq_eyebrow")
  faqTitle                       String?       @map("faq_title")
  faqTitleAccent                 String?       @map("faq_title_accent")
  faqDescription                 String?       @map("faq_description")
  faqSupportTitle                String?       @map("faq_support_title")
  faqSupportText                 String?       @map("faq_support_text")
  heroCtaLabel                   String?       @map("hero_cta_label")
  heroCtaUrl                     String?       @map("hero_cta_url")
  heroCarouselIntervalSeconds    Int           @default(7) @map("hero_carousel_interval_seconds")
  subscriptionSectionEnabled     Boolean       @default(false) @map("subscription_section_enabled")
  subscriptionCtaUrl             String?       @map("subscription_cta_url")
  subscriptionHeroNote           String?       @map("subscription_hero_note")
  subscriptionItemOne            String?       @map("subscription_item_one")
  subscriptionItemTwo            String?       @map("subscription_item_two")
  subscriptionItemThree          String?       @map("subscription_item_three")
  purchaseSuccessMessage         String?       @map("purchase_success_message")
  requireTaxId                   Boolean       @default(false) @map("require_tax_id")
  newsletterSectionEnabled       Boolean       @default(false) @map("newsletter_section_enabled")
  newsletterEyebrow              String?       @map("newsletter_eyebrow")
  newsletterTitle                String?       @map("newsletter_title")
  newsletterDescription          String?       @map("newsletter_description")
  newsletterSenderName           String        @default("IQ Kids") @map("newsletter_sender_name")
  newsletterFromEmail            String        @default("no-reply@iqkids.com.ar") @map("newsletter_from_email")
  newsletterReplyToEmail         String?       @map("newsletter_reply_to_email")
  newsletterTestRecipients       String[]      @default([]) @map("newsletter_test_recipients")
  newsletterDailyLimit           Int           @default(80) @map("newsletter_daily_limit")
  showFloatingWhatsapp           Boolean       @default(true) @map("show_floating_whatsapp")
  isStoreOpen                    Boolean       @default(true) @map("is_store_open")
  createdAt                      DateTime      @default(now()) @map("created_at")
  updatedAt                      DateTime      @updatedAt @map("updated_at")
  activeShippingRule             ShippingRule? @relation(fields: [activeShippingRuleId], references: [id], onDelete: SetNull)

  @@map("store_settings")
}

model Coupon {
  id                            String              @id @default(uuid()) @db.Uuid
  code                          String              @unique
  description                   String?
  discountType                  CouponDiscountType  @default(PERCENTAGE) @map("discount_type")
  discountPercentage            Decimal?            @map("discount_percentage") @db.Decimal(5, 2)
  fixedDiscountArs              Int?                @map("fixed_discount_ars")
  // Buy X pay Y coupons (e.g. 3x2): every X eligible units the customer pays Y (cheapest ones free).
  buyQuantity                   Int?                @map("buy_quantity")
  payQuantity                   Int?                @map("pay_quantity")
  // Whether the free units still count toward the free shipping threshold.
  freeUnitsCountForFreeShipping Boolean             @default(true) @map("free_units_count_for_free_shipping")
  // false: units of different products are grouped together; true: each product forms its own groups.
  buyXPayYSameProductOnly       Boolean             @default(false) @map("buy_x_pay_y_same_product_only")
  // Products that already bundle several units (e.g. "3 display"): [{ productId, unitsPerPack }].
  // Each pack counts as unitsPerPack units, so one pack of 3 with a 3x2 gets a third off.
  buyXPayYPackUnits             Json                @default("[]") @map("buy_x_pay_y_pack_units")
  usageType                     CouponUsageType     @default(UNLIMITED) @map("usage_type")
  active                        Boolean             @default(true)
  createdAt                     DateTime            @default(now()) @map("created_at")
  updatedAt                     DateTime            @updatedAt @map("updated_at")
  orders                        Order[]
  emailAutomations              EmailAutomation[]
  // Referral program coupons are created from the referral portal and managed in /admin/referidos.
  referralKind                  ReferralCouponKind? @map("referral_kind")
  referralAccountId             String?             @map("referral_account_id") @db.Uuid
  referralAccount               ReferralAccount?    @relation(fields: [referralAccountId], references: [id], onDelete: SetNull)

  @@unique([referralAccountId, referralKind], map: "coupons_referral_account_kind_key")
  @@index([active, code], map: "coupons_active_code_idx")
  @@map("coupons")
}

model Testimonial {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  roleLabel String?  @map("role_label")
  quote     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder], map: "testimonials_active_sort_idx")
  @@map("testimonials")
}

model HomeSlide {
  id             String    @id @default(uuid()) @db.Uuid
  eyebrow        String?
  title          String
  mobileTitle    String?   @map("mobile_title")
  subtitle       String?
  badges         String[]  @default([])
  ctaLabel       String?   @map("cta_label")
  ctaUrl         String?   @map("cta_url")
  imageUrl       String    @map("image_url")
  mobileImageUrl String?   @map("mobile_image_url")
  imageAlt       String?   @map("image_alt")
  // Soft wash over the photo behind the text; some artworks look better without it.
  imageOverlay   Boolean   @default(true) @map("image_overlay")
  // Banner: la imagen se muestra completa (el diseño ya trae los textos) y el botón va encima.
  fitImage       Boolean   @default(false) @map("fit_image")
  // Botón del banner: texto, link, colores, forma, posición y tamaño (escritorio y celular).
  overlayButton  Json?     @map("overlay_button")
  active         Boolean   @default(true)
  // Optional publishing window; the home only shows the slide between these moments.
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  sortOrder      Int       @default(0) @map("sort_order")
  // Home de la tienda (RETAIL) o carrusel de la portada de /mayoristas (WHOLESALE). Mismo admin para los dos.
  channel        SalesChannel @default(RETAIL)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([active, sortOrder], map: "home_slides_active_sort_idx")
  @@index([channel, active, sortOrder], map: "home_slides_channel_active_sort_idx")
  @@map("home_slides")
}

model WholesalePage {
  id        String   @id @default("default")
  content   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wholesale_page")
}

model WholesaleLead {
  id                 String              @id @default(uuid()) @db.Uuid
  status             WholesaleLeadStatus @default(NEW)
  name               String
  phone              String
  email              String
  businessName       String?             @map("business_name")
  businessType       String              @map("business_type")
  cuit               String?
  street             String
  floor              String?
  city               String
  province           String
  postalCode         String              @map("postal_code")
  reference          String?
  monthlyVolume      String?             @map("monthly_volume")
  message            String?             @db.Text
  adminNotes         String?             @map("admin_notes") @db.Text
  ipAddress          String?             @map("ip_address")
  userAgent          String?             @map("user_agent")
  notifiedAt         DateTime?           @map("notified_at")
  notificationError  String?             @map("notification_error")
  // Sesión de marketing en la que se registró: guarda UTM y origen de la visita.
  marketingSessionId String?             @map("marketing_session_id") @db.Uuid
  marketingVisitorId String?             @map("marketing_visitor_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  marketingSession   MarketingSession?   @relation(fields: [marketingSessionId], references: [id], onDelete: SetNull)
  customers          WholesaleCustomer[]

  @@index([status, createdAt], map: "wholesale_leads_status_created_idx")
  @@index([ipAddress, createdAt], map: "wholesale_leads_ip_created_idx")
  @@index([marketingSessionId], map: "wholesale_leads_marketing_session_idx")
  @@map("wholesale_leads")
}

// Maestro de clientes mayoristas: un registro por CUIT. Un mismo email puede tener varios CUIT.
model WholesaleCustomer {
  id                      String           @id @default(uuid()) @db.Uuid
  email                   String
  phone                   String
  contactName             String           @map("contact_name")
  businessName            String?          @map("business_name")
  legalName               String?          @map("legal_name")
  businessType            String?          @map("business_type")
  cuit                    String           @unique
  taxCondition            TaxCondition?    @map("tax_condition")
  street                  String
  floor                   String?
  city                    String
  province                String
  postalCode              String           @map("postal_code")
  reference               String?
  allowDeferredPayment    Boolean          @default(false) @map("allow_deferred_payment")
  extraDiscountPercentage Decimal          @default(0) @map("extra_discount_percentage") @db.Decimal(5, 2)
  active                  Boolean          @default(true)
  adminNotes              String?          @map("admin_notes") @db.Text
  // Logística fija para este cliente. Vacío = la decide la tabla de códigos postales.
  preferredCarrier        ShippingCarrier? @map("preferred_carrier")
  // Precio de envío fijo para este cliente (entregas grandes con costo propio). Vacío = el que calcule la web.
  shippingPriceArs        Int?             @map("shipping_price_ars")
  leadId                  String?          @map("lead_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  lead                    WholesaleLead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  orders                  Order[]

  @@index([email], map: "wholesale_customers_email_idx")
  @@index([createdAt], map: "wholesale_customers_created_idx")
  @@map("wholesale_customers")
}

// Lo que se vende en /mayoristas, con su propio precio: un display suelto, un bulto de composición fija
// o una caja que arma el cliente. Siempre se compone de productos de la tienda (los displays base),
// y así viaja a la planilla y a la app de operaciones.
model WholesaleProduct {
  id              String                      @id @default(uuid()) @db.Uuid
  name            String
  description     String                      @default("")
  // Textos de la tarjeta y la ficha. Vacío = el texto automático (ver wholesaleProductTexts en bundles.ts).
  label           String                      @default("")
  subtitle        String                      @default("")
  priceNote       String                      @default("") @map("price_note")
  buttonLabel     String                      @default("") @map("button_label")
  linkLabel       String                      @default("") @map("link_label")
  imageUrl        String                      @default("") @map("image_url")
  imageAlt        String                      @default("") @map("image_alt")
  priceArs        Int                         @map("price_ars")
  unitsPerDisplay Int                         @default(12) @map("units_per_display")
  active          Boolean                     @default(true)
  soldOut         Boolean                     @default(false) @map("sold_out")
  // La etiqueta "Más elegido" de /mayoristas: la lleva uno solo (o ninguno), se elige en el admin.
  highlighted     Boolean                     @default(false)
  sortOrder       Int                         @default(0) @map("sort_order")
  // FIXED: composición fija (components con cantidad). CUSTOM: el cliente elige los sabores (components) hasta llenar boxDisplays.
  kind            WholesaleProductKind        @default(FIXED)
  boxDisplays     Int                         @default(10) @map("box_displays")
  // Paquete de una unidad del producto mayorista. Vacío = se calcula con los displays que trae.
  weightGrams     Int?                        @map("weight_grams")
  lengthCm        Int?                        @map("length_cm")
  widthCm         Int?                        @map("width_cm")
  heightCm        Int?                        @map("height_cm")
  // Producto de la tienda principal: foto y colores de la tarjeta. Se completa solo con el primero de la composición.
  productId       String?                     @map("product_id") @db.Uuid
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  product         Product?                    @relation(fields: [productId], references: [id], onDelete: SetNull)
  components      WholesaleProductComponent[]
  orderItems      OrderItem[]

  @@index([active, sortOrder], map: "wholesale_products_active_sort_idx")
  @@map("wholesale_products")
}

// Un display base dentro de un producto mayorista. En FIXED, quantity es cuántos displays de ese producto trae
// cada unidad; en CUSTOM es un sabor que el cliente puede elegir (quantity no se usa y queda en 0).
model WholesaleProductComponent {
  id                 String           @id @default(uuid()) @db.Uuid
  wholesaleProductId String           @map("wholesale_product_id") @db.Uuid
  productId          String           @map("product_id") @db.Uuid
  quantity           Int              @default(0)
  sortOrder          Int              @default(0) @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at")
  wholesaleProduct   WholesaleProduct @relation(fields: [wholesaleProductId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([wholesaleProductId, productId], map: "wholesale_product_components_product_key")
  @@index([productId], map: "wholesale_product_components_retail_idx")
  @@map("wholesale_product_components")
}

enum WholesaleProductKind {
  FIXED
  CUSTOM
}

// Condiciones de compra mayorista (una sola fila). Los datos bancarios son los de StoreSettings.
model WholesaleSettings {
  id                             String   @id @default("default")
  minDisplays                    Int      @default(10) @map("min_displays")
  enableMercadoPago              Boolean  @default(true) @map("enable_mercado_pago")
  enableBankTransfer             Boolean  @default(true) @map("enable_bank_transfer")
  enableEcheq                    Boolean  @default(true) @map("enable_echeq")
  echeqMaxDays                   Int      @default(15) @map("echeq_max_days")
  echeqInstructions              String?  @map("echeq_instructions")
  enableBankTransferDiscount     Boolean  @default(false) @map("enable_bank_transfer_discount")
  bankTransferDiscountPercentage Decimal  @default(0) @map("bank_transfer_discount_percentage") @db.Decimal(5, 2)
  freeShippingThresholdArs       Int?     @map("free_shipping_threshold_ars")
  orderNotificationEmails        String[] @default([]) @map("order_notification_emails")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  @@map("wholesale_settings")
}

enum WholesaleLeadStatus {
  NEW
  CONTACTED
  CLIENT
  DISCARDED
}

model FrequentlyAskedQuestion {
  id        String   @id @default(uuid()) @db.Uuid
  question  String
  answer    String   @db.Text
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder], map: "frequently_asked_questions_active_sort_idx")
  @@map("frequently_asked_questions")
}

model HomeFeaturedProductSlot {
