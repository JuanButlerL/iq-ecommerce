generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
}

enum ProductColorTheme {
  CACAO
  BANANA
  PEANUT
}

enum ShippingMode {
  FLAT
  PROVINCE
}

enum PaymentMethod {
  BANK_TRANSFER
  MERCADO_PAGO
}

enum PaymentProvider {
  MANUAL_TRANSFER
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  PROOF_UPLOADED
  PAID
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PROOF_UPLOADED
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum SyncStatus {
  PENDING
  SUCCESS
  ERROR
}

enum SyncProvider {
  MOCK
  GOOGLE_SHEETS
  APPS_SCRIPT
}

enum SyncJobStatus {
  PENDING
  PROCESSING
  SUCCESS
  ERROR
}

enum SyncLogStatus {
  SUCCESS
  ERROR
}

enum OrderSource {
  WEB
}

enum PaymentWebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum EmailAutomationTrigger {
  WELCOME_LEAD
  CART_ABANDONED
  ORDER_CREATED
  POST_PURCHASE
}

enum EmailSendStatus {
  SENT
  SKIPPED
  ERROR
}

enum NewsletterSubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum NewsletterConsentSource {
  CHECKOUT
  WELCOME_POPUP
}

enum CouponUsageType {
  UNLIMITED
  SINGLE_USE
  SINGLE_USE_PER_CUSTOMER
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum MarketingSourceCategory {
  DIRECT
  ORGANIC
  META
  GOOGLE
  TIKTOK
  EMAIL
  WHATSAPP
  REFERRAL
  OTHER
}

enum MarketingSourcePlatform {
  DIRECT
  INSTAGRAM
  FACEBOOK
  THREADS
  GOOGLE
  YOUTUBE
  TIKTOK
  WHATSAPP
  EMAIL
  REFERRAL
  OTHER
}

enum MarketingEventType {
  SESSION_STARTED
  POPUP_CAPTURED
  CART_CAPTURED
  ORDER_CREATED
  ORDER_CONFIRMED
}

model AdminUser {
  id             String    @id @default(uuid()) @db.Uuid
  supabaseUserId String?   @unique @map("supabase_user_id") @db.Uuid
  email          String    @unique
  fullName       String    @map("full_name")
  passwordHash   String?   @map("password_hash")
  role           AdminRole @default(OPERATIONS)
  allowedSections String[] @default([]) @map("allowed_sections")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique
  shortDescription String            @map("short_description")
  longDescription  String            @map("long_description")
  priceArs         Int               @map("price_ars")
  homeVarietyLabel String?           @map("home_variety_label")
  colorTheme       ProductColorTheme @map("color_theme")
  visualAccentHex  String?           @map("visual_accent_hex")
  visualSurfaceHex String?           @map("visual_surface_hex")
  visualTextHex    String?           @map("visual_text_hex")
  active           Boolean           @default(true)
  visible          Boolean           @default(true)
  manualSoldOut    Boolean           @default(false) @map("manual_sold_out")
  featured         Boolean           @default(false)
  sortOrder        Int               @default(0) @map("sort_order")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  homeFeaturedSlots HomeFeaturedProductSlot[]
  images           ProductImage[]
  orderItems       OrderItem[]

  @@index([active, visible, featured], map: "products_visibility_idx")
  @@index([sortOrder], map: "products_sort_idx")
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  filePath   String   @map("file_path")
  publicUrl  String   @map("public_url")
  altText    String   @map("alt_text")
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder], map: "product_images_sort_idx")
  @@map("product_images")
}

model ShippingRule {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  description           String?
  mode                  ShippingMode
  flatPrice             Int?                   @map("flat_price")
  discountThresholdArs  Int?                   @map("discount_threshold_ars")
  discountPercentage    Int?                   @map("discount_percentage")
  active                Boolean                @default(true)
  isDefault             Boolean                @default(false) @map("is_default")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  provinces             ShippingRuleProvince[]
  storeSettings         StoreSettings[]

  @@map("shipping_rules")
}

model ShippingRuleProvince {
  id             String       @id @default(uuid()) @db.Uuid
  shippingRuleId String       @map("shipping_rule_id") @db.Uuid
  provinceCode   String       @map("province_code")
  provinceName   String       @map("province_name")
  shippingPrice  Int          @map("shipping_price")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  shippingRule   ShippingRule @relation(fields: [shippingRuleId], references: [id], onDelete: Cascade)

  @@unique([shippingRuleId, provinceCode], map: "shipping_rule_province_code_key")
  @@index([provinceCode], map: "shipping_rule_province_idx")
  @@map("shipping_rule_provinces")
}

model StoreSettings {
  id                     String        @id @default("default")
  storeName              String        @map("store_name")
  storeCurrency          String        @default("ARS") @map("store_currency")
  whatsappNumber         String        @map("whatsapp_number")
  instagramUrl           String?       @map("instagram_url")
  contactEmail           String        @map("contact_email")
  bankAlias              String        @map("bank_alias")
  bankCbu                String        @map("bank_cbu")
  bankName               String        @map("bank_name")
  bankHolder             String        @map("bank_holder")
  bankTaxId              String        @map("bank_tax_id")
  minimumOrderAmount     Int           @map("minimum_order_amount")
  freeShippingThreshold  Int           @map("free_shipping_threshold")
  flatShippingPrice      Int           @default(0) @map("flat_shipping_price")
  shippingMode           ShippingMode  @default(FLAT) @map("shipping_mode")
  activeShippingRuleId   String?       @map("active_shipping_rule_id") @db.Uuid
  checkoutMessage        String?       @map("checkout_message")
  transferInstructions   String?       @map("transfer_instructions")
  enableBankTransfer     Boolean       @default(true) @map("enable_bank_transfer")
  enableMercadoPago      Boolean       @default(true) @map("enable_mercado_pago")
  enableBankTransferDiscount Boolean   @default(false) @map("enable_bank_transfer_discount")
  bankTransferDiscountPercentage Decimal @default(0) @map("bank_transfer_discount_percentage") @db.Decimal(5, 2)
  orderReservationHours  Int?          @map("order_reservation_hours")
  institutionalBanner    String?       @map("institutional_banner")
  announcementBarEnabled Boolean       @default(false) @map("announcement_bar_enabled")
  announcementBarText    String?       @map("announcement_bar_text")
  heroCtaLabel           String?       @map("hero_cta_label")
  heroCtaUrl             String?       @map("hero_cta_url")
  subscriptionSectionEnabled Boolean   @default(false) @map("subscription_section_enabled")
  subscriptionCtaUrl     String?       @map("subscription_cta_url")
  subscriptionHeroNote   String?       @map("subscription_hero_note")
  subscriptionItemOne    String?       @map("subscription_item_one")
  subscriptionItemTwo    String?       @map("subscription_item_two")
  subscriptionItemThree  String?       @map("subscription_item_three")
  purchaseSuccessMessage String?       @map("purchase_success_message")
  requireTaxId           Boolean       @default(false) @map("require_tax_id")
  showFloatingWhatsapp   Boolean       @default(true) @map("show_floating_whatsapp")
  isStoreOpen            Boolean       @default(true) @map("is_store_open")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  activeShippingRule     ShippingRule? @relation(fields: [activeShippingRuleId], references: [id], onDelete: SetNull)

  @@map("store_settings")
}

model Coupon {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  description        String?
  discountType       CouponDiscountType @default(PERCENTAGE) @map("discount_type")
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  fixedDiscountArs   Int?     @map("fixed_discount_ars")
  usageType          CouponUsageType @default(UNLIMITED) @map("usage_type")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  orders             Order[]
  emailAutomations   EmailAutomation[]

  @@index([active, code], map: "coupons_active_code_idx")
  @@map("coupons")
}

model Testimonial {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  roleLabel   String?  @map("role_label")
  quote       String
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder], map: "testimonials_active_sort_idx")
  @@map("testimonials")
}

model HomeFeaturedProductSlot {
  id          String   @id @default(uuid()) @db.Uuid
  slotOrder   Int      @unique @map("slot_order")
  productId   String   @map("product_id") @db.Uuid
  eyebrow     String
  title       String
  description String
  quote       String?  @db.Text
  buttonLabel String   @map("button_label")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([slotOrder], map: "home_featured_product_slots_order_idx")
  @@index([productId], map: "home_featured_product_slots_product_idx")
  @@map("home_featured_product_slots")
}

model MarketingSession {
  id             String                  @id @default(uuid()) @db.Uuid
  visitorId      String                  @map("visitor_id")
  sessionKey     String                  @unique @map("session_key")
  entryPath      String                  @map("entry_path")
  entryUrl       String?                 @map("entry_url")
  referrerUrl    String?                 @map("referrer_url")
  referrerHost   String?                 @map("referrer_host")
  sourceCategory MarketingSourceCategory @default(DIRECT) @map("source_category")
  sourcePlatform MarketingSourcePlatform @default(DIRECT) @map("source_platform")
  sourceChannel  String                  @default("Direct") @map("source_channel")
  sourceLabel    String                  @default("Direct") @map("source_label")
  isPaid         Boolean                 @default(false) @map("is_paid")
  utmSource      String?                 @map("utm_source")
  utmMedium      String?                 @map("utm_medium")
  utmCampaign    String?                 @map("utm_campaign")
  utmContent     String?                 @map("utm_content")
  utmTerm        String?                 @map("utm_term")
  gclid          String?
  fbclid         String?
  ttclid         String?
  msclkid        String?
  landingQuery   Json?                   @map("landing_query")
  gaClientId     String?                 @map("ga_client_id")
  email          String?
  firstSeenAt    DateTime                @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime                @default(now()) @map("last_seen_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  cartRecoveryLeads CartRecoveryLead[]
  orders         Order[]
  events         MarketingEvent[]

  @@index([email, firstSeenAt], map: "marketing_sessions_email_first_seen_idx")
  @@index([sourceCategory, sourcePlatform, firstSeenAt], map: "marketing_sessions_source_idx")
  @@index([utmCampaign], map: "marketing_sessions_campaign_idx")
  @@index([visitorId, firstSeenAt], map: "marketing_sessions_visitor_idx")
  @@map("marketing_sessions")
}

model CartRecoveryLead {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String
  recoveryToken        String    @unique @map("recovery_token")
  items                Json
  subtotalArs          Int       @default(0) @map("subtotal_ars")
  currency             String    @default("ARS")
  province             String?
  status               String    @default("CAPTURED")
  checkoutOrderId      String?   @map("checkout_order_id") @db.Uuid
  checkoutOrderNumber  String?   @map("checkout_order_number")
  checkoutStartedAt    DateTime? @map("checkout_started_at")
  convertedOrderId     String?   @map("converted_order_id") @db.Uuid
  convertedOrderNumber String?   @map("converted_order_number")
  convertedAt          DateTime? @map("converted_at")
  freeShippingToken    String?   @unique @map("free_shipping_token")
  freeShippingGrantedAt DateTime? @map("free_shipping_granted_at")
  freeShippingExpiresAt DateTime? @map("free_shipping_expires_at")
  freeShippingRedeemedAt DateTime? @map("free_shipping_redeemed_at")
  freeShippingOrderId  String?   @map("free_shipping_order_id") @db.Uuid
  userAgent            String?   @map("user_agent")
  marketingSessionId   String?   @map("marketing_session_id") @db.Uuid
  marketingVisitorId   String?   @map("marketing_visitor_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  marketingSession     MarketingSession? @relation(fields: [marketingSessionId], references: [id], onDelete: SetNull)
  marketingEvents      MarketingEvent[]
  emailLogs            EmailSendLog[]

  @@index([email], map: "cart_recovery_leads_email_idx")
  @@index([status], map: "cart_recovery_leads_status_idx")
  @@index([marketingSessionId], map: "cart_recovery_leads_marketing_session_idx")
  @@index([marketingVisitorId], map: "cart_recovery_leads_marketing_visitor_idx")
  @@index([updatedAt], map: "cart_recovery_leads_updated_at_idx")
  @@map("cart_recovery_leads")
}

model NewsletterSubscriber {
  id             String                   @id @default(uuid()) @db.Uuid
  email          String                   @unique
  status         NewsletterSubscriberStatus @default(SUBSCRIBED)
  consentSource  NewsletterConsentSource  @map("consent_source")
  consentVersion String                   @map("consent_version")
  consentedAt    DateTime                 @map("consented_at")
  unsubscribedAt DateTime?                @map("unsubscribed_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  @@index([status, consentedAt], map: "newsletter_subscribers_status_consented_idx")
  @@map("newsletter_subscribers")
}

model EmailAutomation {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String
  trigger        EmailAutomationTrigger
  active         Boolean                @default(false)
  delayHours     Int                    @default(24) @map("delay_hours")
  subject        String
  previewText    String?                @map("preview_text")
  bodyText       String                 @map("body_text") @db.Text
  ctaLabel       String?                @map("cta_label")
  ctaUrlTemplate String?                @map("cta_url_template")
  senderName     String                 @default("IQ Kids") @map("sender_name")
  fromEmail      String                 @default("no-reply@iqkids.com.ar") @map("from_email")
  replyToEmail   String?                @map("reply_to_email")
  bccEmail       String?                @map("bcc_email")
  couponId       String?                @map("coupon_id") @db.Uuid
  couponHeadline String?                @map("coupon_headline")
  couponMessage  String?                @map("coupon_message") @db.Text
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  coupon         Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  logs           EmailSendLog[]

  @@index([active, trigger], map: "email_automations_active_trigger_idx")
  @@index([couponId], map: "email_automations_coupon_idx")
  @@map("email_automations")
}

model EmailSendLog {
  id                 String                 @id @default(uuid()) @db.Uuid
  automationId       String                 @map("automation_id") @db.Uuid
  trigger            EmailAutomationTrigger
  status             EmailSendStatus
  recipientEmail     String                 @map("recipient_email")
  subject            String
  targetType         String                 @map("target_type")
  targetId           String                 @map("target_id")
  orderId            String?                @map("order_id") @db.Uuid
  cartRecoveryLeadId String?                @map("cart_recovery_lead_id") @db.Uuid
  providerMessageId  String?                @map("provider_message_id")
  ctaUrl             String?                @map("cta_url")
  clickToken         String?                @unique @map("click_token")
  openToken          String?                @unique @map("open_token")
  openCount          Int                    @default(0) @map("open_count")
  firstOpenedAt      DateTime?              @map("first_opened_at")
  lastOpenedAt       DateTime?              @map("last_opened_at")
  clickCount         Int                    @default(0) @map("click_count")
  firstClickedAt     DateTime?              @map("first_clicked_at")
  lastClickedAt      DateTime?              @map("last_clicked_at")
  convertedOrderId   String?                @map("converted_order_id") @db.Uuid
  convertedOrderNumber String?              @map("converted_order_number")
  convertedAt        DateTime?              @map("converted_at")
  errorMessage       String?                @map("error_message")
  sentAt             DateTime?              @map("sent_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  automation         EmailAutomation        @relation(fields: [automationId], references: [id], onDelete: Cascade)
  order              Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  convertedOrder     Order?                 @relation("EmailLogConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  cartRecoveryLead   CartRecoveryLead?      @relation(fields: [cartRecoveryLeadId], references: [id], onDelete: SetNull)

  @@unique([automationId, targetType, targetId], map: "email_send_logs_automation_target_key")
  @@index([recipientEmail, createdAt], map: "email_send_logs_recipient_created_idx")
  @@index([status, createdAt], map: "email_send_logs_status_created_idx")
  @@index([firstOpenedAt], map: "email_send_logs_first_opened_at_idx")
  @@index([convertedAt], map: "email_send_logs_converted_at_idx")
  @@map("email_send_logs")
}

model MarketingEvent {
  id                 String             @id @default(uuid()) @db.Uuid
  marketingSessionId String             @map("marketing_session_id") @db.Uuid
  eventType          MarketingEventType @map("event_type")
  path               String
  email              String?
  cartRecoveryLeadId String?            @map("cart_recovery_lead_id") @db.Uuid
  orderId            String?            @map("order_id") @db.Uuid
  metadata           Json?
  occurredAt         DateTime           @default(now()) @map("occurred_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  marketingSession   MarketingSession   @relation(fields: [marketingSessionId], references: [id], onDelete: Cascade)
  cartRecoveryLead   CartRecoveryLead?  @relation(fields: [cartRecoveryLeadId], references: [id], onDelete: SetNull)
  order              Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([marketingSessionId, occurredAt], map: "marketing_events_session_occurred_idx")
  @@index([eventType, occurredAt], map: "marketing_events_type_occurred_idx")
  @@index([email, occurredAt], map: "marketing_events_email_occurred_idx")
  @@index([orderId], map: "marketing_events_order_idx")
  @@index([cartRecoveryLeadId], map: "marketing_events_lead_idx")
  @@map("marketing_events")
}

model ShortLink {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  targetUrl   String   @map("target_url") @db.Text
  title       String?
  description String?
  active      Boolean  @default(true)
  clickCount  Int      @default(0) @map("click_count")
  lastClickedAt DateTime? @map("last_clicked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active, slug], map: "short_links_active_slug_idx")
  @@map("short_links")
}

model Order {
  id                    String               @id @default(uuid()) @db.Uuid
  publicOrderNumber     String               @unique @map("public_order_number")
  checkoutRequestKey    String?              @unique @map("checkout_request_key")
  customerFirstName     String               @map("customer_first_name")
  customerLastName      String               @map("customer_last_name")
  customerEmail         String               @map("customer_email")
  customerPhone         String               @map("customer_phone")
  customerTaxId         String?              @map("customer_tax_id")
  province              String
  locality              String
  postalCode            String               @map("postal_code")
  addressLine           String               @map("address_line")
  addressNumber         String?              @map("address_number")
  addressWithoutNumber  Boolean?             @map("address_without_number")
  addressExtra          String?              @map("address_extra")
  notes                 String?
  newsletterOptIn       Boolean?             @map("newsletter_opt_in")
  newsletterOptInAt     DateTime?            @map("newsletter_opt_in_at")
  couponId              String?              @map("coupon_id") @db.Uuid
  couponCode            String?              @map("coupon_code")
  discountPercentage    Decimal?             @map("discount_percentage") @db.Decimal(5, 2)
  discountArs           Int                  @default(0) @map("discount_ars")
  paymentMethodDiscountPercentage Decimal?   @map("payment_method_discount_percentage") @db.Decimal(5, 2)
  paymentMethodDiscountArs Int               @default(0) @map("payment_method_discount_ars")
  subtotalArs           Int                  @map("subtotal_ars")
  shippingArs           Int                  @map("shipping_ars")
  totalArs              Int                  @map("total_ars")
  currency              String               @default("ARS")
  paymentMethod         PaymentMethod        @default(BANK_TRANSFER) @map("payment_method")
  paymentProvider       PaymentProvider      @default(MANUAL_TRANSFER) @map("payment_provider")
  paymentProviderReference String?           @map("payment_provider_reference")
  paymentProviderStatus String?              @map("payment_provider_status")
  paymentProviderStatusDetail String?        @map("payment_provider_status_detail")
  paymentStatus         PaymentStatus        @default(PENDING) @map("payment_status")
  paymentInitiatedAt    DateTime?            @map("payment_initiated_at")
  paidAt                DateTime?            @map("paid_at")
  orderStatus           OrderStatus          @default(PENDING_PAYMENT) @map("order_status")
  syncStatus            SyncStatus           @default(PENDING) @map("sync_status")
  syncLastError         String?              @map("sync_last_error")
  syncedAt              DateTime?            @map("synced_at")
  source                OrderSource          @default(WEB)
  reservationExpiresAt  DateTime?            @map("reservation_expires_at")
  marketingSessionId    String?              @map("marketing_session_id") @db.Uuid
  marketingVisitorId    String?              @map("marketing_visitor_id")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  coupon                Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  marketingSession      MarketingSession?    @relation(fields: [marketingSessionId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  paymentProofs         PaymentProof[]
  mercadoPagoPreference MercadoPagoPreference?
  mercadoPagoPayments   MercadoPagoPayment[]
  paymentWebhookEvents  PaymentWebhookEvent[]
  syncJobs              SyncJob[]
  emailLogs             EmailSendLog[]
  convertedEmailLogs    EmailSendLog[]      @relation("EmailLogConvertedOrder")
  marketingEvents       MarketingEvent[]

  @@index([couponId], map: "orders_coupon_idx")
  @@index([createdAt], map: "orders_created_at_idx")
  @@index([orderStatus, paymentStatus], map: "orders_status_idx")
  @@index([paymentMethod, paymentStatus], map: "orders_payment_method_status_idx")
  @@index([marketingSessionId], map: "orders_marketing_session_idx")
  @@index([marketingVisitorId], map: "orders_marketing_visitor_idx")
  @@index([syncStatus], map: "orders_sync_status_idx")
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot")
  unitPriceArs        Int      @map("unit_price_ars")
  quantity            Int
  lineTotalArs        Int      @map("line_total_ars")
  createdAt           DateTime @default(now()) @map("created_at")
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "order_items_order_idx")
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  note      String?
  changedBy String?     @map("changed_by")
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt], map: "order_status_history_order_idx")
  @@map("order_status_history")
}

model PaymentProof {
  id                 String    @id @default(uuid()) @db.Uuid
  orderId            String    @map("order_id") @db.Uuid
  storagePath        String    @map("storage_path")
  publicUrl          String?   @map("public_url")
  fileName           String    @map("file_name")
  fileSize           Int       @map("file_size")
  mimeType           String    @map("mime_type")
  transferSenderName String?   @map("transfer_sender_name")
  transferDate       DateTime? @map("transfer_date")
  transferReference  String?   @map("transfer_reference")
  customerNote       String?   @map("customer_note")
  uploadedAt         DateTime  @default(now()) @map("uploaded_at")
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, uploadedAt], map: "payment_proofs_order_idx")
  @@map("payment_proofs")
}

model SyncJob {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  provider        SyncProvider
  status          SyncJobStatus @default(PENDING)
  attempts        Int           @default(0)
  nextRetryAt     DateTime?     @map("next_retry_at")
  lastError       String?       @map("last_error")
  payloadSnapshot Json?         @map("payload_snapshot")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  logs            SyncLog[]

  @@index([status, nextRetryAt], map: "sync_jobs_status_idx")
  @@map("sync_jobs")
}

model SyncLog {
  id              String        @id @default(uuid()) @db.Uuid
  syncJobId       String        @map("sync_job_id") @db.Uuid
  attemptNumber   Int           @map("attempt_number")
  requestPayload  Json?         @map("request_payload")
  responsePayload Json?         @map("response_payload")
  status          SyncLogStatus
  errorMessage    String?       @map("error_message")
  createdAt       DateTime      @default(now()) @map("created_at")
  syncJob         SyncJob       @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId, attemptNumber], map: "sync_logs_job_idx")
  @@map("sync_logs")
}

model MercadoPagoPreference {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @unique @map("order_id") @db.Uuid
  preferenceId     String   @unique @map("preference_id")
  externalReference String  @unique @map("external_reference")
  initPoint        String   @map("init_point")
  sandboxInitPoint String?  @map("sandbox_init_point")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "mercado_pago_preferences_order_idx")
  @@map("mercado_pago_preferences")
}

model MercadoPagoPayment {
  id                  String    @id @default(uuid()) @db.Uuid
  orderId             String    @map("order_id") @db.Uuid
  mercadoPagoPaymentId String   @unique @map("mercado_pago_payment_id")
  merchantOrderId     String?   @map("merchant_order_id")
  preferenceId        String?   @map("preference_id")
  externalReference   String?   @map("external_reference")
  liveMode            Boolean?  @map("live_mode")
  status              String
  statusDetail        String?   @map("status_detail")
  transactionAmount   Int?      @map("transaction_amount")
  currencyId          String?   @map("currency_id")
  payerEmail          String?   @map("payer_email")
  dateCreated         DateTime? @map("date_created")
  dateApproved        DateTime? @map("date_approved")
  dateLastUpdated     DateTime? @map("date_last_updated")
  rawData             Json?     @map("raw_data")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt], map: "mercado_pago_payments_order_idx")
  @@index([preferenceId], map: "mercado_pago_payments_preference_idx")
  @@map("mercado_pago_payments")
}

model PaymentWebhookEvent {
  id                  String                         @id @default(uuid()) @db.Uuid
  orderId             String?                        @map("order_id") @db.Uuid
  provider            PaymentProvider
  webhookEventId      String                         @unique @map("webhook_event_id")
  topic               String
  action              String?
  resourceId          String?                        @map("resource_id")
  requestId           String?                        @map("request_id")
  signatureTs         String?                        @map("signature_ts")
  signatureV1         String?                        @map("signature_v1")
  processingStatus    PaymentWebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  processedAt         DateTime?                      @map("processed_at")
  paymentReference    String?                        @map("payment_reference")
  errorMessage        String?                        @map("error_message")
  queryParams         Json?                          @map("query_params")
  headers             Json?                          @map("headers")
  payload             Json?                          @map("payload")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  order               Order?                         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt], map: "payment_webhook_events_order_idx")
  @@index([provider, resourceId], map: "payment_webhook_events_resource_idx")
  @@map("payment_webhook_events")
}
